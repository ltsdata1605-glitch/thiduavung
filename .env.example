# Copy this file to .env and fill in real values. .env is gitignored.

# Firebase project config — from Firebase Console > Project Settings > Your apps.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"

# KHÔNG còn VITE_SEED_ADMIN_PASSWORD.
#
# Vite thay mọi biến VITE_* thành chuỗi cố định ngay lúc build, nên mật khẩu
# đặt ở đây sẽ nằm nguyên văn trong file JS công khai — ai tải bundle về cũng
# đọc được. Tài khoản quản trị đầu tiên của một project Firestore trắng phải
# được tạo THỦ CÔNG một lần:
#   1. Firebase Console > Authentication > Add user
#      email: <accountId>@tnb.local   (vd: 3717@tnb.local)
#   2. Firebase Console > Firestore > tạo document users/<accountId> với:
#      { accountId: "<accountId>", name: "...", role: "super_admin",
#        isActive: true, createdAt: "<ISO date>" }
# Sau đó mọi tài khoản khác tạo trong màn hình "Quản Lý Tài Khoản" của app.
