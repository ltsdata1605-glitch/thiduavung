# Copy this file to .env and fill in real values. .env is gitignored.

# Firebase project config — from Firebase Console > Project Settings > Your apps.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"

# Only used to seed the Super Admin (3717) account if Firestore's `users`
# collection is ever completely empty (fresh project / recovery). Pick a
# strong password — never commit the real value, only this placeholder.
VITE_SEED_ADMIN_PASSWORD="change-me-strong-password"
